{
  "name": "@dataphone/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:init": "node dist/database/cli.js init",
    "db:seed": "node dist/database/cli.js seed",
    "db:seed-demo": "node dist/database/demo-cli.js",
    "db:bootstrap-admin": "node dist/auth/bootstrap-cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@dataphone/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "exceljs": "4.4.0",
    "jose": "6.2.12",
    "mongodb": "7.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.2",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  }
}
