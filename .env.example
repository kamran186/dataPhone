NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/dataphone?directConnection=true
CORS_ORIGIN=http://localhost:5173
# Set a stable random value of at least 32 bytes for production or multi-instance use.
JWT_SECRET=
# Base64-encoded 32-byte random key. Keep the same key to decrypt port documents and credentials.
DATAPHONE_PORT_ENCRYPTION_KEY=
# For read-only Bandwidth inventory, set account credentialRef to BANDWIDTH_MAIN.
# Supply values through a local secret manager or shell, never in this file.
# DATAPHONE_CARRIER_BANDWIDTH_MAIN_USERNAME=
# DATAPHONE_CARRIER_BANDWIDTH_MAIN_PASSWORD=
