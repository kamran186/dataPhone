NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://dataphone:dataphone-local@127.0.0.1:54328/dataphone
CORS_ORIGIN=http://localhost:5173
# Set a stable random value of at least 32 bytes for production or multi-instance use.
JWT_SECRET=
# Base64-encoded 32-byte random key. Keep the same key to decrypt port documents and credentials.
DATAPHONE_PORT_ENCRYPTION_KEY=
# Explicitly enable the simulated carrier only in local development or test.
DATAPHONE_ENABLE_MOCK_CARRIER=true
DATAPHONE_SEED_DEMO=true
DATAPHONE_DEMO_PASSWORD=Admin@123456
# For read-only Bandwidth inventory and search, set account credentialRef to BANDWIDTH_MAIN.
# Supply values through a local secret manager or shell, never in this file.
# DATAPHONE_CARRIER_BANDWIDTH_MAIN_USERNAME=
# DATAPHONE_CARRIER_BANDWIDTH_MAIN_PASSWORD=

# Peerless: USERNAME is userId, PASSWORD is passCode; CUSTOMER is required.
# DATAPHONE_CARRIER_PEERLESS_MAIN_USERNAME=
# DATAPHONE_CARRIER_PEERLESS_MAIN_PASSWORD=
# DATAPHONE_CARRIER_PEERLESS_MAIN_CUSTOMER=
# BulkVS API username/password, or the exact Basic/Bearer authorization supplied for the test account.
# DATAPHONE_CARRIER_BULKVS_MAIN_USERNAME=
# DATAPHONE_CARRIER_BULKVS_MAIN_PASSWORD=
# DATAPHONE_CARRIER_BULKVS_MAIN_AUTHORIZATION=
