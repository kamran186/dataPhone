# Reference only. Inject actual secrets through a deployment secret manager.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://dataphone:CHANGE_ME@postgres.example:5432/dataphone?sslmode=verify-full
CORS_ORIGIN=https://dataphone.example.com
JWT_SECRET=
DATAPHONE_PORT_ENCRYPTION_KEY=
DATAPHONE_ENABLE_MOCK_CARRIER=false
# DATAPHONE_CARRIER_BANDWIDTH_MAIN_USERNAME=
# DATAPHONE_CARRIER_BANDWIDTH_MAIN_PASSWORD=

# Peerless: USERNAME is userId, PASSWORD is passCode; CUSTOMER is required.
# DATAPHONE_CARRIER_PEERLESS_MAIN_USERNAME=
# DATAPHONE_CARRIER_PEERLESS_MAIN_PASSWORD=
# DATAPHONE_CARRIER_PEERLESS_MAIN_CUSTOMER=
# BulkVS API username/password, or the exact Basic/Bearer authorization supplied for the test account.
# DATAPHONE_CARRIER_BULKVS_MAIN_USERNAME=
# DATAPHONE_CARRIER_BULKVS_MAIN_PASSWORD=
# DATAPHONE_CARRIER_BULKVS_MAIN_AUTHORIZATION=
